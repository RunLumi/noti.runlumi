{
  "name": "lumi-noti",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "queues": {
    "producers": [
      {
        "binding": "DELIVERY_QUEUE",
        "queue": "noti-deliveries",
      },
    ],
    "consumers": [
      {
        "queue": "noti-deliveries",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "noti-dead-letters",
      },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumi-noti",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
  "compatibility_flags": ["nodejs_compat"],
  "send_email": [
    {
      "name": "AUTH_EMAIL",
    },
  ],
  "vars": {
    "APP_ORIGIN": "https://noti.runlumi.app",
    "AUTH_FROM_EMAIL": "noreply@runlumi.app",
  },
}
