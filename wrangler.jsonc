{
  "name": "lumi-noti",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "queues": {
    "producers": [
      {
        "binding": "DELIVERY_QUEUE",
        "queue": "noti-deliveries",
      },
    ],
    "consumers": [
      {
        "queue": "noti-deliveries",
        // F176: kept small. Each message is acked or retried on its own, but anything that
        // fails the whole invocation still redelivers the batch; batching buys D1 round
        // trips, not downstream batching.
        "max_batch_size": 5,
        // Mirrored by QUEUE_MAX_RETRIES in src/pipeline/consumer.ts (asserted by a test).
        // Our own attempt budget (13, F177) lives in the ledger, not here.
        "max_retries": 5,
        "dead_letter_queue": "noti-dead-letters",
      },
      {
        // F180: without a consumer, DLQ messages are deleted after four days. This one only
        // moves the ledger row to the terminal `dead_lettered` state (src/pipeline/dead-letter.ts).
        "queue": "noti-dead-letters",
        "max_batch_size": 1,
        "max_retries": 1,
        "max_concurrency": 1,
      },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumi-noti",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
  "compatibility_flags": ["nodejs_compat"],
  "send_email": [
    {
      "name": "AUTH_EMAIL",
    },
  ],
  "vars": {
    "APP_ORIGIN": "https://noti.runlumi.app",
    "AUTH_FROM_EMAIL": "noreply@runlumi.app",
    // Public identifier of the GitHub App. Not a secret: it appears in install URLs.
    // Used to reject payloads that claim a different App, alongside the webhook secret.
    // Replace with the real App ID; until then, webhook ingress fails closed.
    "GITHUB_APP_ID": "REPLACE_WITH_GITHUB_APP_ID",
    // Which KEK version (secret KEK_V<n>) wraps new connection keys. Not a secret.
    // Flip only after the new KEK secret is deployed; see docs/IMPLEMENTATION.md.
    "KMS_ACTIVE_VERSION": "1",
    // Public GitHub App identifiers (see docs/GITHUB_APP.md). The client SECRET is a
    // Worker secret, never a var. Until these are real, /api/github/install returns 503.
    "GITHUB_APP_SLUG": "REPLACE_WITH_GITHUB_APP_SLUG",
    "GITHUB_CLIENT_ID": "REPLACE_WITH_GITHUB_CLIENT_ID",
  },
}
