{
  "name": "lumi-noti",
  // The Worker entry composes the API (src/index.ts) with the dashboard (ADR 0017). It imports
  // TanStack Start virtual modules, so it only builds through Vite: use `npm run dev` and
  // `npm run deploy`, not `wrangler dev` or a bare `wrangler deploy`.
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "queues": {
    "producers": [
      {
        "binding": "DELIVERY_QUEUE",
        "queue": "noti-deliveries",
      },
    ],
    "consumers": [
      {
        "queue": "noti-deliveries",
        // F176: kept small. Each message is acked or retried on its own, but anything that
        // fails the whole invocation still redelivers the batch; batching buys D1 round
        // trips, not downstream batching.
        "max_batch_size": 5,
        // Mirrored by QUEUE_MAX_RETRIES in src/pipeline/consumer.ts (asserted by a test).
        // Our own attempt budget (13, F177) lives in the ledger, not here.
        "max_retries": 5,
        "dead_letter_queue": "noti-dead-letters",
      },
      {
        // F180: without a consumer, DLQ messages are deleted after four days. This one only
        // moves the ledger row to the terminal `dead_lettered` state (src/pipeline/dead-letter.ts).
        "queue": "noti-dead-letters",
        "max_batch_size": 1,
        "max_retries": 1,
        "max_concurrency": 1,
      },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumi-noti",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
  "compatibility_flags": ["nodejs_compat"],
  // The default *.workers.dev URL exposes the same Worker on a second hostname, outside the
  // custom domain's controls (APP_ORIGIN). Production is served from the custom domain, so the
  // workers.dev route is switched off. `wrangler dev` is unaffected. If a deployment ever
  // relied on workers.dev, give it a custom domain or route first.
  "workers_dev": false,
  // The dashboard build (web/dist/client) is served from the Worker's own assets; the Vite
  // plugin fills in `directory`. `html_handling: none` keeps `/_shell.html` addressable by the
  // Worker, which serves it for every navigation (src/web/shell.ts); `not_found_handling: none`
  // sends every miss to the Worker. Fingerprinted /assets/* and the shell are served directly,
  // with the web/public/_headers rules.
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "send_email": [
    {
      "name": "AUTH_EMAIL",
    },
  ],
  "vars": {
    "APP_ORIGIN": "https://noti.runlumi.app",
    "AUTH_FROM_EMAIL": "noreply@runlumi.app",
    // Public identifier of the GitHub App. Not a secret: it appears in install URLs.
    // Used to reject payloads that claim a different App, alongside the webhook secret.
    // Replace with the real App ID; until then, webhook ingress fails closed.
    "GITHUB_APP_ID": "REPLACE_WITH_GITHUB_APP_ID",
    // Which KEK version (secret KEK_V<n>) wraps new connection keys. Not a secret.
    // Flip only after the new KEK secret is deployed; see docs/IMPLEMENTATION.md.
    "KMS_ACTIVE_VERSION": "1",
    // Which deployment this is: production | staging | development (F34). An input to the KEK check
    // value below. A staging deploy sets "staging" and its own check values.
    "ENVIRONMENT_NAME": "production",
    // Key check values of KEK_V1 / KEK_V2 for THIS environment: 32 hex characters of
    // HMAC-SHA-256(KEK, "lumi-noti/kcv/v1:" + ENVIRONMENT_NAME). Public and one-way. A Worker whose
    // KEK does not produce its check value refuses to serve (kek_environment_mismatch). Compute
    // with `node scripts/kek-destroy-check.mjs check-value` (docs/RUNBOOK.md). Until the real value
    // is set the Worker fails closed, like the GitHub App placeholders below.
    "KEK_CHECK_V1": "REPLACE_WITH_KEK_CHECK_V1",
    // Empty unless a second KEK is deployed for a rotation.
    "KEK_CHECK_V2": "",
    // Retention for operational records (src/pipeline/retention.ts). Days, as strings.
    // Delivery rows: 30-365 (default 90); audit events: 30-3650 (default 365). Out-of-range
    // or non-numeric values fall back to the default. Not secrets.
    "DELIVERY_RETENTION_DAYS": "90",
    "AUDIT_RETENTION_DAYS": "365",
    // Public GitHub App identifiers (see docs/GITHUB_APP.md). The client SECRET is a
    // Worker secret, never a var. Until these are real, /api/github/install returns 503.
    "GITHUB_APP_SLUG": "REPLACE_WITH_GITHUB_APP_SLUG",
    "GITHUB_CLIENT_ID": "REPLACE_WITH_GITHUB_CLIENT_ID",
    // The custom-webhook destination sends to a URL the customer chooses (SSRF surface, ADR
    // 0014, AR-30). It stays "false" until the release criteria in the ADR are met: workspace
    // host allowlist, periodic re-resolution, and a canary test of Workers egress. When it is
    // "false" the API refuses to create or re-enable one and the consumer refuses to send to a
    // stored one. Not a secret.
    "GENERIC_WEBHOOK_ENABLED": "false",
    // "true" freezes every writer (HTTP 503, cron skipped, queue retried) for a migration window.
    "MAINTENANCE_MODE": "false",
  },
}
