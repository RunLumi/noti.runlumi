# Local development only. Never commit real secrets.
#
# Every key here must match a binding or secret referenced in `src/`.
# `npm run typecheck` will not catch a mismatch — see the test note below.

# --- Secrets (set with `wrangler secret put <NAME>` in deployed environments) ---

# Key-encryption keys (KEKs) for destination credentials, by version. Each is exactly
# 64 hexadecimal characters (32 bytes): `openssl rand -hex 32`. KMS_ACTIVE_VERSION in
# wrangler.jsonc names the one that wraps new connection keys. Leave KEK_V2 empty unless
# you are rotating; see docs/IMPLEMENTATION.md "Key rotation".
KEK_V1=replace-with-64-hex-characters
KEK_V2=

# Deployment name and the key check values of the KEKs above (F34). Locally the environment is
# `development` (accepted only with a local APP_ORIGIN: localhost, 127.0.0.1, [::1] or *.localhost),
# where a check value is optional; when you set one it must match its KEK, so
# copying a staging KEK into a dev file is caught. Compute: `node scripts/kek-destroy-check.mjs
# check-value` (docs/RUNBOOK.md). Not secrets.
ENVIRONMENT_NAME=development
KEK_CHECK_V1=
KEK_CHECK_V2=

# Optional. 64 hex characters (`openssl rand -hex 32`). Keys the tenant-scoped credential
# fingerprint shown next to a credential (F39). Its own secret, not a KEK derivative, so a KEK
# rotation never changes a fingerprint. Empty: no fingerprints are shown.
FINGERPRINT_KEY=

# LEGACY v0 key (pre-envelope format). Read-only: the scheduled job re-seals every v0
# row under the KEK and then this key can be retired. Same 64-hex format.
ENCRYPTION_KEY=replace-with-64-hex-characters

# Shared secret used to verify GitHub webhook signatures (X-Hub-Signature-256).
GITHUB_WEBHOOK_SECRET=replace-me

# OAuth client secret of the GitHub App. Used once per install to verify, with the
# installer's own token, that they can access the installation (ADR 0008).
GITHUB_CLIENT_SECRET=replace-me

# Better Auth signing key for session cookies. Minimum 32 characters; use a
# high-entropy random value, not a memorable phrase.
BETTER_AUTH_SECRET=replace-with-at-least-32-characters-of-entropy

# Non-secret configuration -----------------------------------------------
# These are also declared as `vars` in wrangler.jsonc. Override locally only if
# your dev origin differs (e.g. http://localhost:5173).
APP_ORIGIN=http://localhost:5173
AUTH_FROM_EMAIL=noreply@runlumi.app

# Public ID of the GitHub App (it appears in install URLs, so it is not a secret).
# Inbound events are matched against github_installations by this id AND the
# installation id from the payload. Until this is the real App ID, webhook ingress
# fails closed with 403 — which is the intended behaviour, not a misconfiguration.
GITHUB_APP_ID=000000

# Custom-webhook destination (a URL the customer chooses; ADR 0014). Off by default, in
# wrangler.jsonc and here. Set to `true` locally only to work on it; production stays false
# until the release criteria in the ADR are met.
GENERIC_WEBHOOK_ENABLED=false

# Optional secret. A Slack, Discord, Lark or Microsoft Teams Workflows webhook URL that receives alert
# state changes (firing, still firing, resolved; docs/RUNBOOK.md). A bearer secret, so set it with
# `wrangler secret put ALERT_WEBHOOK_URL`, never as a var. Validated by the destination URL policy; an
# unusable value is a /health warning and alerts then go to the log only (which always runs). Empty: log only.
ALERT_WEBHOOK_URL=

# Optional secret. Comma-separated user ids of platform operators: the only people who see per-job state
# and alert-webhook health in GET /api/observability/summary (a workspace admin does not). Empty: nobody.
PLATFORM_OPERATOR_USER_IDS=

# Who may create an account (ADR 0047): open | invite_only | closed. Empty means open, which suits local
# development; wrangler.jsonc sets invite_only for a deploy. An unknown value is treated as closed.
SIGNUP_MODE=
# Exact addresses that may sign up while invite_only (comma-separated). A secret on a deploy.
SIGNUP_ALLOWLIST=

# --- Notes -----------------------------------------------------------------
# `AUTH_EMAIL` is a Cloudflare Email Sending binding declared in wrangler.jsonc,
# not an environment variable, so it does not belong in this file. Local email
# delivery requires a verified account; see docs/AUTH_SETUP.md.
#
# This file is asserted against `Bindings` by tests/config.dev_vars.test.ts, so
# adding a secret here without wiring it into code will fail CI.