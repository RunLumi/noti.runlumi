{
  "name": "lumi-noti",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run typecheck:web && npm test && npm run build:web"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@base-ui/react": "^1.0.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^0.468.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "class-variance-authority": "^0.7.1",
    "better-auth": "1.6.33",
    "@better-auth/passkey": "1.6.33",
    "@better-auth/drizzle-adapter": "1.6.33",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260901.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.6"
  }
}
