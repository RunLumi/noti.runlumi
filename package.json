{
  "name": "lumi-noti",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "cd web && vite dev",
    "deploy": "npm run build:web && node scripts/verify_worker_bundle.mjs --deploy && wrangler deploy --config web/dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "cd web && vite build",
    "preview": "cd web && vite preview",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run typecheck:web && npm run test && npm run build:web && npm run verify:worker-bundle",
    "verify:worker-bundle": "node scripts/verify_worker_bundle.mjs",
    "check": "npm run format:check && npm run lint && npm run verify",
    "audit:gate": "node scripts/audit-gate.mjs",
    "schema:test": "python3 scripts/test_auth_schema.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@fontsource-variable/geist": "5.3.0",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "^4.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "5.20261010.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.14.0",
    "drizzle-kit": "^0.31.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.71.1",
    "vite": "^8.3.4",
    "vitest": "5.0.3",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.26",
    "caniuse-lite": "1.0.30001813",
    "electron-to-chromium": "1.5.441",
    "exsolve": "1.1.1"
  }
}
