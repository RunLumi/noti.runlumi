{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    // "node" is listed explicitly: vite 8 / vitest 4 no longer pull @types/node in through a
    // triple-slash reference, and tests/ and scripts import node:* modules.
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,

    // Hardening beyond `strict`. Each of these has already caught or would catch a real
    // class of defect in this codebase; see docs/specs/01-platform-runtime.md F01.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", ".wrangler", "web"]
}
